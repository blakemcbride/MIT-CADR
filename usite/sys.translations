;;;-*- Mode:LISP; Package:FS; Readtable:CL; Base:10 -*-

;; Don't forget that this file has to be read in by the very first
;; LISP-REINITIALIZE.  That is, before the ERROR-TABLE is loaded and
;; before things like LOCAL-FILE are loaded.
;; Be careful.

(FS:SET-LOGICAL-PATHNAME-HOST "SYS"
  :PHYSICAL-HOST "LOCAL-BRIDGE"
  :TRANSLATIONS '(("SITE;" "//usite//")
		  ("*;*;*;" "//sys//*//*//*//")
		  ("*;*;" "//sys//*//*//")
		  ("*;" "//sys//*//")))
